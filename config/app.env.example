# app.env.example — Plantilla de variables de entorno.
# Copiar a app.env y ajustar según el entorno.
# NUNCA versionar app.env con credenciales reales.

# ── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# MQTT_USERNAME=parking
# MQTT_PASSWORD=changeme

# ── Hardware (ESP32 WROOM-32 vía UART — reemplaza al M4/RPMsg) ─────────────────
# Puerto serie de la BeaglePlay conectado al ESP32. Verificar con:
#   dmesg | grep tty   y   ls -l /dev/ttyS*
# Configurar el puerto una vez: stty -F /dev/ttyS2 115200 raw -echo
UART_DEVICE=/dev/ttyS2
UART_BAUDRATE=115200
# Poner "true" para desarrollo sin ESP32 físico.
UART_SIMULATED=false
HEARTBEAT_INTERVAL_S=1.0
LANE_ID=ENTRADA-1

# ── Hardware (LEGADO M4/RPMsg — ya no se usa, conservado por referencia) ───────
# RPMSG_DEVICE=/dev/rpmsg0
# RPMSG_SIMULATED=false

# ── Visión ────────────────────────────────────────────────────────────────────
# Índice del dispositivo V4L2 para la cámara USB. En BeaglePlay suele ser /dev/video0
CAMERA_INDEX=0
TMP_CAPTURES_PATH=/tmp/parking_captures
MODEL_PATH=/opt/parking-edge/Modelo/best_plate_yolo11m_int8.tflite

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_PATH=/var/lib/parking/parking.db

# ── Pagos ─────────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER_URL=https://pagos.proveedor.example.com
# Secreto — NO versionar
PAYMENT_API_KEY=your-secret-api-key-here
PAYMENT_STORE_PATH=/var/lib/parking/payment_queue.db
PAYMENT_TIMEOUT_S=5.0
# Usar mock local en desarrollo
MOCK_PAYMENT_SERVER=false
MOCK_PAYMENT_PORT=5050
MOCK_PAYMENT_FAIL_RATE=0.0
MOCK_PAYMENT_SLOW_MS=0
PARKING_FEE_COP=5000
CB_FAIL_THRESHOLD=5
CB_RESET_TIMEOUT_S=30
RECONCILE_INTERVAL_S=60

# ── Configuración general ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
POLICIES_PATH=/opt/parking-edge/config/policies.yaml

# ── Dashboard web ─────────────────────────────────────────────────────────────
DASHBOARD_PORT=8080
# Secreto — NO versionar
DASHBOARD_SECRET_KEY=change-me-in-production
DASHBOARD_ADMIN_PASSWORD=admin
