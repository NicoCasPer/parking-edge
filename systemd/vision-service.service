[Unit]
Description=Parking Edge — Vision Service (YOLO + OCR)
After=mosquitto.service hardware-controller.service
Requires=mosquitto.service

[Service]
Type=simple
User=parking
Group=parking
SupplementaryGroups=video

WorkingDirectory=/opt/parking-edge
EnvironmentFile=/opt/parking-edge/config/app.env
ExecStart=/usr/bin/python3 -m services.vision_service.app.main

Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=15s

# El modelo YOLO INT8 puede necesitar más memoria en la primera carga
MemoryMax=512M
CPUQuota=80%

# Seguridad
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/tmp/parking_captures /var/lib/parking /var/log/parking

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vision-service

[Install]
WantedBy=multi-user.target
