[Unit]
Description=Parking Edge — Web Dashboard (Flask + WebSocket)
After=mosquitto.service database.service
Requires=mosquitto.service database.service

[Service]
Type=simple
User=parking
Group=parking

WorkingDirectory=/opt/parking-edge
EnvironmentFile=/opt/parking-edge/config/app.env
ExecStart=/usr/bin/python3 -m web_dashboard.backend.app

Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=10s

MemoryMax=256M
CPUQuota=30%

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/parking /var/log/parking

StandardOutput=journal
StandardError=journal
SyslogIdentifier=web-dashboard

[Install]
WantedBy=multi-user.target
