[Unit]
Description=Parking Edge — Connectivity Service (telemetría y monitoreo)
After=mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple
User=parking
Group=parking

WorkingDirectory=/opt/parking-edge
EnvironmentFile=/opt/parking-edge/config/app.env
ExecStart=/usr/bin/python3 -m services.connectivity_service.app.main

Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=10s

MemoryMax=64M
CPUQuota=10%

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/parking

StandardOutput=journal
StandardError=journal
SyslogIdentifier=connectivity-service

[Install]
WantedBy=multi-user.target
