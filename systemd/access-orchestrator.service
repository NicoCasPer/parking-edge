[Unit]
Description=Parking Edge — Access Orchestrator (decisión whitelist/pago)
After=mosquitto.service database.service
Requires=mosquitto.service database.service

[Service]
Type=simple
User=parking
Group=parking

WorkingDirectory=/opt/parking-edge
EnvironmentFile=/opt/parking-edge/config/app.env
ExecStart=/usr/bin/python3 -m services.access_orchestrator.app.main

Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=10s

MemoryMax=128M
CPUQuota=20%

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/parking /var/log/parking

StandardOutput=journal
StandardError=journal
SyslogIdentifier=access-orchestrator

[Install]
WantedBy=multi-user.target
