[Unit]
Description=Parking Edge — Payment Integration (circuit breaker + store-and-forward)
After=mosquitto.service database.service
Requires=mosquitto.service

[Service]
Type=simple
User=parking
Group=parking

WorkingDirectory=/opt/parking-edge
EnvironmentFile=/opt/parking-edge/config/app.env
ExecStart=/usr/bin/python3 -m services.payment_integration.app.main

Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=10s

MemoryMax=128M
CPUQuota=20%

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/parking /var/log/parking

StandardOutput=journal
StandardError=journal
SyslogIdentifier=payment-integration

[Install]
WantedBy=multi-user.target
