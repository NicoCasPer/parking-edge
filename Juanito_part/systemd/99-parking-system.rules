# udev rules para BeaglePlay Parking System
# Ubicar en: /etc/udev/rules.d/99-parking-system.rules

# Permitir acceso a dispositivos RPMsg
SUBSYSTEM=="rpmsg", MODE="0666", GROUP="dialout"

# Permitir acceso a GPIO del MCU
SUBSYSTEM=="gpio", MODE="0666", GROUP="gpio"

# Permitir acceso a remoteproc
SUBSYSTEM=="remoteproc", MODE="0666", GROUP="root"

# Crear symlink para fácil acceso al M4
KERNEL=="rpmsg0", SYMLINK+="m4_rpmsg", MODE="0666"

# Otorgar permisos a cámara CSI
SUBSYSTEM=="video4linux", MODE="0666", GROUP="video"
