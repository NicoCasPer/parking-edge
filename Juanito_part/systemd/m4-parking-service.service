[Unit]
Description=BeaglePlay M4 Parking System Service
Documentation=man:parking-system(8)
After=m4-firmware.service network.target
Wants=m4-firmware.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/parking/parking_service.py
WorkingDirectory=/opt/parking
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/parking"

# Reintentar si falla
Restart=on-failure
RestartSec=10

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=parking-service

# Seguridad
PrivateTmp=yes
NoNewPrivileges=yes
ReadOnlyPaths=/opt/parking/Modelo
ReadWritePaths=/opt/parking/tmp_captures

# Usuario
User=root
Group=root

[Install]
WantedBy=multi-user.target
